# Build output — build.sh regenerates all of this.
.build/
build/
.swiftpm/
*.xcuserstate
.DS_Store

# Python's bytecode cache, left in Tests/ by the probe scripts.
__pycache__/

# Signing material that's tied to one Apple Developer account and should
# never be committed, even though the scripts happily run without it.
*.provisionprofile
*.p12
*.mobileprovision

# A local virtualenv for a one-off tool (aura-logo)
.venv/

# Local work that is not part of the browser: the logo exploration, and the
# reverse-engineering scratch folder with its 300 MB of slices.
aura-logo/
arc-rea/

# The filter lists Tools/filters.py downloads. What it makes of them is
# committed in Resources/Shield; the lists themselves are fetched again.
.filters-cache/
